# Copy to .env (git-ignored) and fill in. Real environment variables win over this file.

# OpenRouter: one key for many models. Key at https://openrouter.ai/keys; copy a model id that supports tools from
# https://openrouter.ai/models?supported_parameters=tools (OPENROUTER_MODEL has no default).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional: comma-separated model ids to try if the first fails, and 'allow' to also route to providers that may keep prompts.
#OPENROUTER_FALLBACKS=
#OPENROUTER_DATA_COLLECTION=deny

# claude (Claude Code engine, local only) or openrouter. Default: claude on localhost, openrouter when hosted.
#VOLTBRIDGE_PROVIDER=openrouter

# Hosted only: Google sign-in through Supabase (leave unset to use the shared VOLTBRIDGE_TOKEN). Keys: Supabase > Project Settings > API Keys.
#SUPABASE_URL=https://<project>.supabase.co
#SUPABASE_SERVICE_KEY=
# Monthly spending caps in dollars (per user, and for the whole server) and whether any Google account may sign in.
#USER_MONTHLY_CAP_USD=0.5
#GLOBAL_MONTHLY_CAP_USD=10
#OPEN_SIGNUP=true
