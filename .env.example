# Copy to .env (git-ignored) and fill in. Real environment variables win over this file.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Default gemini-2.5-flash; check Google's current model list and free-tier limits.
#GEMINI_MODEL=gemini-2.5-flash

# claude (Claude Code engine, local only) or gemini. Default: claude on localhost, gemini when hosted.
#VOLTBRIDGE_PROVIDER=gemini
